# E2B Cloud Sandbox runtime. Put the real key only in Coolify/local secrets,
# never in a committed repository file.
E2B_API_KEY=your-e2b-api-key
E2B_TEMPLATE=base
E2B_WORKDIR=/app/my-nextjs-app
E2B_PREVIEW_PORT=3000
E2B_SANDBOX_TIMEOUT_MS=3600000
E2B_RECONNECT_BY_METADATA=true
E2B_COMMAND_TIMEOUT_MS=120000
E2B_INSTALL_TIMEOUT_MS=240000
E2B_START_TIMEOUT_MS=120000
E2B_DEV_SERVER_LOG_TAIL_BYTES=12000
KLAWPEN_PACKAGE_INSTALL_TIMEOUT_MS=240000
KLAWPEN_PREVIEW_SMOKE_TIMEOUT_MS=120000
PREVIEW_PROXY_TIMEOUT_MS=120000

# Dedicated preview origin. Point this DNS record at the builder API.
PREVIEW_PROXY_PUBLIC_ORIGIN=https://api.builder.klawpen.com
PREVIEW_PROXY_SECRET=change-this-long-random-secret

# Optional: use Vercel AI SDK + OpenRouter/OpenAI-compatible providers for
# streaming orchestration. Keep enabled once the new dependencies are deployed.
KLAWPEN_AI_SDK_ENABLED=true
KLAWPEN_AI_SDK_STREAMING=true
KLAWPEN_AI_SDK_MANUAL_FALLBACK=true
KLAWPEN_FAST_RELIABLE_MODE=true
KLAWPEN_BROAD_BUILD_POWER_AUTO=false
KLAWPEN_ENABLE_ARCHITECT_SPEC=false
KLAWPEN_LLM_FALLBACK_MODELS=deepseek/deepseek-chat,anthropic/claude-3.5-sonnet

# Klawpen artifact/action parser. Shell actions stay restricted by default.
# File actions always apply through the safe E2B sandbox file writer.
KLAWPEN_STREAM_ACTION_APPLY=true
KLAWPEN_STREAM_HEARTBEAT_MS=5000
KLAWPEN_SSE_HEARTBEAT_MS=5000
KLAWPEN_SHELL_ACTIONS_ENABLED=false
KLAWPEN_SHELL_INSTALLS_ENABLED=false
KLAWPEN_SHELL_ACTION_TIMEOUT_MS=120000
