# Backend Docker client should use the restricted socket proxy instead of mounting
# /var/run/docker.sock directly into the API container.
DOCKER_SOCKET_PROXY_URL=http://docker-socket-proxy:2375

# Project container resource limits.
PROJECT_CONTAINER_MEMORY_BYTES=536870912
PROJECT_CONTAINER_NANO_CPUS=1000000000
PROJECT_CONTAINER_PIDS_LIMIT=100

# Keep root filesystem read-only while mounting the writable Next.js workspace
# as a named volume and cache/build directories as tmpfs.
PROJECT_READONLY_ROOTFS=true
PROJECT_WORKSPACE_VOLUME_ENABLED=true
PROJECT_WORKSPACE_VOLUME_PREFIX=klawpen-workspace-data-

# Dedicated preview origin. Point this DNS record at the dedicated builder server.
PREVIEW_PROXY_PUBLIC_ORIGIN=https://preview.builder.klawpen.com
PREVIEW_PROXY_SECRET=change-this-long-random-secret

